# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000
# Interface to bind (0.0.0.0 = all IPv4 interfaces, required in containers).
HOST=0.0.0.0

# Use 127.0.0.1 (not localhost) so the connection always reaches the Docker IPv4 binding.
DATABASE_URL="postgresql://nexora:nexora@127.0.0.1:5432/nexora?schema=public"

# REQUIRED. At least 32 characters. The API refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="2h"

# Comma-separated list of browser origins allowed to call the API and open sockets.
CORS_ORIGINS="http://localhost:5173"

# Swagger UI at /api/docs. Defaults to enabled outside production.
SWAGGER_ENABLED=true

# pretty | json
LOG_FORMAT=pretty

# Number of reverse-proxy hops in front of the API whose X-Forwarded-For entry is trusted for the client IP
# (rate limiting). 0 locally; 1 on Railway. Never set it higher than the real number of proxies.
TRUST_PROXY=0

# Login/register attempts per minute per client IP.
AUTH_RATE_LIMIT=10
