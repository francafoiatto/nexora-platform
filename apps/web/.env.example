# Optional. By default the web app calls the API through the Vite dev proxy (/api, /socket.io).
# For a separately hosted API (production), set the API base URL at build time:
# VITE_API_URL="https://api.example.com/api/v1"
#
# Socket.IO defaults to the origin of VITE_API_URL. Override only if realtime is served elsewhere:
# VITE_SOCKET_URL="https://realtime.example.com"
#
# The production build derives the CSP connect-src (https + wss) from these values.

# Dev proxy target used by `pnpm dev` (defaults to http://127.0.0.1:3000).
# VITE_PROXY_TARGET="http://127.0.0.1:3000"
