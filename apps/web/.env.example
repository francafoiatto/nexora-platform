# Optional. By default the web app calls the API through the Vite dev proxy (/api, /socket.io).
# Set these only when the API is served from a different origin (e.g. production builds).
# VITE_API_URL="https://api.example.com/api/v1"
# VITE_SOCKET_URL="https://api.example.com"

# Dev proxy target used by `pnpm dev` (defaults to http://127.0.0.1:3000).
# VITE_PROXY_TARGET="http://127.0.0.1:3000"
